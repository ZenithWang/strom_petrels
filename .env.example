# Copy this file to .env in the project root and edit paths for each machine.
# Existing shell environment variables take precedence over this file.

STORM_PETREL_PROJECT_ROOT=/path/to/strom_petrels
STORM_PETREL_DB_PATH=${STORM_PETREL_PROJECT_ROOT}/data_processing/storm_petrel_2021_full.db
STORM_PETREL_AUDIO_ROOT=/path/to/recordings
STORM_PETREL_WORKSPACE_DIR=${STORM_PETREL_PROJECT_ROOT}/workspace
STORM_PETREL_MODEL_ROOT=${STORM_PETREL_WORKSPACE_DIR}/models/nested_cv_balanced
STORM_PETREL_DEPLOYMENT_MODEL_DIR=${STORM_PETREL_WORKSPACE_DIR}/models/deployment
STORM_PETREL_LONG_RECORDING_ANALYSIS_DIR=${STORM_PETREL_WORKSPACE_DIR}/long_recording_analysis
STORM_PETREL_COMP_CHICK_ADULT_DIR=${STORM_PETREL_WORKSPACE_DIR}/comp_chick_adult
STORM_PETREL_CHICK_SCREENING_DIR=${STORM_PETREL_WORKSPACE_DIR}/chick_screening
